```gitignore
# =========================
# Rust / Cargo
# =========================

# Cargo 构建产物
target/
# 任务执行文档
assignment/
# Cargo 锁文件
# 应用程序建议提交 Cargo.lock
# 库项目通常可以不提交 Cargo.lock
# Cargo.lock


# =========================
# 构建产物
# =========================

build/
dist/
out/
bin/

# 临时文件
tmp/
temp/
*.tmp
*.log


# =========================
# IDE
# =========================

# JetBrains 系列 IDE
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/


# =========================
# 操作系统
# =========================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux / Unix
*~


# =========================
# 环境配置与密钥
# =========================

.env
.env.*
!.env.example

*.local

# 证书与密钥
*.pem
*.key
*.crt
*.p12
*.pfx


# =========================
# 运行数据
# =========================

logs/
runtime/
data/

*.pid


# =========================
# 性能分析与调试
# =========================

*.prof
*.pprof

# 火焰图与性能分析产物
flamegraph.svg
perf.data
perf.data.old


# =========================
# 覆盖率
# =========================

coverage/
*.profraw
*.profdata
lcov.info
tarpaulin-report.html


# =========================
# Rust tooling
# =========================

# rust-analyzer 等本地工具缓存
.rust-analyzer/

# 本地基准测试结果
criterion/

# cargo-expand 生成的临时文件
expanded.rs


# =========================
# 备份文件
# =========================

*.bak
*.swp
*.swo
```
